# ==============================================================================
# AI-BASED MISSING PERSON IDENTIFICATION AND TRACKING SYSTEM
# Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values before deploying to production:
#   cp .env.example .env
# ==============================================================================

# Application Environment ('production', 'staging', or 'development')
ENVIRONMENT=production

# Server Binding
HOST=0.0.0.0
PORT=8000
WORKERS=4

# JWT Authentication & Cryptographic Security
# CRITICAL: Generate a new 64-character secret in production using:
#   openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-secure-random-64-character-hex-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS Allowed Origins
# In production, restrict to your exact domain(s) separated by commas:
# Example: https://missingpersons.gov.in,https://portal.missingpersons.gov.in
# Use * only during local development.
ALLOWED_ORIGINS=*

# Persistent Storage & Database
# Ensure the directory exists and has write permissions for the application user.
DATABASE_PATH=missing_persons.db
STORAGE_DIR=storage

# Biometric & Computer Vision Calibration
# YuNet Face Detection + SFace Deep Representation (128-D Cosine Similarity)
SIMILARITY_THRESHOLD_HIGH=0.70
SIMILARITY_THRESHOLD_MODERATE=0.50
DEFAULT_TOP_K=5

# Geospatial Mapping (Mappls / MapmyIndia or OpenStreetMap)
# Set MAP_PROVIDER=mappls and provide your keys to use India's official GIS infrastructure:
MAP_PROVIDER=osm
MAPPLS_REST_API_KEY=
MAPPLS_MAP_SDK_KEY=

# CCTNS & National Crime Records Bureau (NCRB) Jurisdiction Configuration
DEFAULT_STATE_CODE=TN
DEFAULT_DISTRICT_CODE=CHN
AGENCY_NAME=National Crime Records Bureau (NCRB) - Ministry of Home Affairs

# Logging & Observability
LOG_LEVEL=info
